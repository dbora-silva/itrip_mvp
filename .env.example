# Copy this file to .env.local and fill in real values. .env.local is gitignored.
#
# See docs/local-environment.md for the full explanation of local vs. hosted Supabase,
# and why SUPABASE_URL and NEXT_PUBLIC_SUPABASE_URL can differ.

# --- Public (safe to expose to the browser) -----------------------------------------
# Local Supabase (via `npm run supabase:start`): http://127.0.0.1:54321
# Hosted Supabase: the Project URL from Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Local Supabase: printed by `npm run supabase:status` after starting.
# Hosted Supabase: the anon/public key from Project Settings > API.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only, Docker Compose sets this automatically -----------------------------
# Only needed when the app runs *inside a container* against a *local* Supabase stack,
# where "localhost" would resolve to the container itself instead of the host machine.
# Leave unset when running `npm run dev` directly on the host, and unset when pointing
# at a hosted Supabase project (its URL is reachable the same way from anywhere).
# SUPABASE_URL=http://host.docker.internal:54321

# --- Never set here --------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY is not used by this application. If a concrete administrative
# need ever justifies it, it must stay server-only, be added with explicit justification,
# and never be committed to this file or to git.
